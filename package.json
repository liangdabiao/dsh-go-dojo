{
  "name": "dsh-go-dojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "围棋道场：3564 关闯关（8 章节谜题/选择/终局流程题）+ BOSS 大模型对弈——dsh agent 亲自执子落子并逐手讲解，局后可复盘留档；源自 online-go.com LearningHub 的 go-game 全量移植。",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client.js",
    "lib",
    "skills",
    "app/dist",
    "app/src",
    "app/public",
    "app/index.html",
    "app/package.json",
    "app/vite.config.ts",
    "app/tsconfig.json",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "go-game",
    "baduk",
    "weiqi",
    "agent-duel",
    "puzzle"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "app:install": "cd app && npm install",
    "app:build": "cd app && npm run build",
    "dev": "node scripts/devserver.mjs 5190"
  },
  "license": "AGPL-3.0"
}
